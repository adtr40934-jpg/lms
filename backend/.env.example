# ==========================================
# Application & Server Environment
# ==========================================
PORT=5000
NODE_ENV=production
# Number of reverse proxy hops (e.g. 1 if behind Nginx / Cloudflare):
TRUST_PROXY_HOPS=1

# ==========================================
# MongoDB Database
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/lms_database

# ==========================================
# Security & JWT
# ==========================================
JWT_SECRET=your_super_strong_random_jwt_secret_here_min_32_characters

# ==========================================
# Allowed CORS Origins (Comma-separated)
# ==========================================
CLIENT_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com

# ==========================================
# Image Hosting & Storage
# ==========================================
IMGBB_API_KEY=your_imgbb_api_key_here

# ==========================================
# Bunny Stream Video Library Integration & Security
# ==========================================
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_stream_api_key
BUNNY_STREAM_TOKEN_AUTH_KEY=your_stream_token_auth_key
BUNNY_STREAM_CDN_URL=https://iframe.mediadelivery.net

BUNNY_STORAGE_ZONE_NAME=https://uk.storage.bunnycdn.com/your_storage_zone
BUNNY_STORAGE_API_KEY=your_storage_api_key
BUNNY_STORAGE_PULL_ZONE_URL=https://your_pull_zone.b-cdn.net/

# ==========================================
# Email / SMTP Configuration (OTP Verification)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME="منصة محمد بهاء التعليمية"
SMTP_FROM_EMAIL=your_email@gmail.com
